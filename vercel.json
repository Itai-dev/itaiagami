{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.itaiagami.com" }],
      "destination": "https://itaiagami.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
